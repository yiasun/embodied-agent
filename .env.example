# Example only: this file is not loaded automatically. Export selected values in your shell.
# Default is rule. Selecting qwen explicitly permits a potentially billable request.
LLM_PROVIDER=rule
LLM_TIMEOUT_SECONDS=30

QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Keep empty here. Supply the actual value securely in your local environment.
QWEN_API_KEY=

OLLAMA_BASE_URL=http://localhost:11434/v1
# Required for ollama: set an already installed LOCAL model name; no model is assumed.
OLLAMA_MODEL=
# No automatic request retries or provider fallbacks are implemented.
